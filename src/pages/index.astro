---
import MatchTable from "../components/MatchTable.astro";
import "../styles/generated.css";
import latest from "../../data/generated/latest.json";
import type { DailyMatches } from "../lib/types";

const data = latest as DailyMatches;
const sections =
  data.sections ??
  [
    {
      id: "today",
      label: "Today",
      description: "Tracked matches on today’s slate.",
      matches: data.matches ?? [],
    },
  ];
const defaultSection = sections[0];
const allSectionMatches = sections.flatMap((section) => section.matches);
const generated = new Intl.DateTimeFormat("en-US", {
  dateStyle: "medium",
  timeStyle: "short",
}).format(new Date(data.generatedAt));
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="BetweenTheCups highlights the best football matches to watch today for World Cup fans."
    />
    <title>BetweenTheCups</title>
  </head>
  <body class="min-h-screen bg-stone-50 text-slate-950">
    <main class="mx-auto flex min-h-screen w-full max-w-7xl flex-col gap-6 px-4 py-6 sm:px-6 lg:px-8">
      <header class="flex flex-col gap-4 border-b border-slate-200 pb-5 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-sm font-semibold uppercase tracking-wide text-emerald-700">Daily watch guide</p>
          <h1 class="mt-2 text-4xl font-semibold text-slate-950 sm:text-5xl">BetweenTheCups</h1>
          <p class="mt-3 max-w-2xl text-base leading-7 text-slate-600">
            The best football to watch until the next World Cup.
          </p>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white px-4 py-3 text-sm text-slate-600 shadow-sm">
          Updated {generated}
        </div>
      </header>

      <section class="grid gap-3 sm:grid-cols-3">
        <div class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
          <div class="text-2xl font-semibold text-slate-950">{defaultSection.matches.length}</div>
          <div class="mt-1 text-sm text-slate-500">matches today</div>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
          <div class="text-2xl font-semibold text-slate-950">
            {sections.find((section) => section.id === "week")?.matches.length ?? defaultSection.matches.length}
          </div>
          <div class="mt-1 text-sm text-slate-500">matches this week</div>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
          <div class="text-2xl font-semibold text-slate-950">
            {Math.max(...allSectionMatches.map((match) => match.excitement), 0)}
          </div>
          <div class="mt-1 text-sm text-slate-500">top excitement score</div>
        </div>
      </section>

      <nav class="flex flex-wrap gap-2" aria-label="Match range">
        {
          sections.map((section, index) => (
            <button
              class:list={[
                "range-tab rounded-lg border px-4 py-2 text-sm font-semibold shadow-sm",
                index === 0
                  ? "border-emerald-700 bg-emerald-700 text-white"
                  : "border-slate-200 bg-white text-slate-700 hover:border-emerald-300 hover:text-emerald-800",
              ]}
              type="button"
              data-range-tab={section.id}
              aria-selected={index === 0 ? "true" : "false"}
            >
              {section.label}
            </button>
          ))
        }
      </nav>

      {
        sections.map((section, index) => (
          <section class:list={["range-panel flex flex-col gap-3", index !== 0 && "hidden"]} data-range-panel={section.id}>
            <div>
              <h2 class="text-xl font-semibold text-slate-950">{section.label}</h2>
              <p class="mt-1 text-sm text-slate-600">{section.description}</p>
            </div>
            {section.matches.length > 0 ? (
              <MatchTable matches={section.matches} tableId={`matches-${section.id}`} />
            ) : (
              <div class="rounded-lg border border-slate-200 bg-white px-4 py-8 text-sm text-slate-600 shadow-sm">
                No tracked matches found for this range.
              </div>
            )}
          </section>
        ))
      }

      <footer class="border-t border-slate-200 py-5 text-sm leading-6 text-slate-500">
        Fixture and broadcast data come from public sources and may change. Check local listings before kickoff.
      </footer>
    </main>
    <script>
      const tabs = document.querySelectorAll("[data-range-tab]");
      const panels = document.querySelectorAll("[data-range-panel]");

      tabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          const active = tab.getAttribute("data-range-tab");
          tabs.forEach((candidate) => {
            const selected = candidate.getAttribute("data-range-tab") === active;
            candidate.setAttribute("aria-selected", String(selected));
            candidate.classList.toggle("border-emerald-700", selected);
            candidate.classList.toggle("bg-emerald-700", selected);
            candidate.classList.toggle("text-white", selected);
            candidate.classList.toggle("border-slate-200", !selected);
            candidate.classList.toggle("bg-white", !selected);
            candidate.classList.toggle("text-slate-700", !selected);
          });
          panels.forEach((panel) => {
            panel.classList.toggle("hidden", panel.getAttribute("data-range-panel") !== active);
          });
        });
      });
    </script>
  </body>
</html>
