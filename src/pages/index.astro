---
import MatchTable from "../components/MatchTable.astro";
import "../styles/generated.css";
import latest from "../../data/generated/latest.json";
import type { DailyMatches } from "../lib/types";

const data = latest as DailyMatches;
const sections =
  data.sections ??
  [
    {
      id: "today",
      label: "Today",
      description: "Tracked matches on today’s slate.",
      matches: data.matches ?? [],
    },
  ];
const defaultSection = sections[0];
const allSectionMatches = sections.flatMap((section) => section.matches);
const generated = new Intl.DateTimeFormat("en-US", {
  dateStyle: "medium",
  timeStyle: "short",
}).format(new Date(data.generatedAt));
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="BetweenTheCups highlights the best football matches to watch today for World Cup fans."
    />
    <title>BetweenTheCups</title>
  </head>
  <body class="min-h-screen bg-stone-50 text-slate-950">
    <main class="mx-auto flex min-h-screen w-full max-w-7xl flex-col gap-4 px-4 py-4 sm:gap-6 sm:px-6 sm:py-6 lg:px-8">
      <header class="flex flex-col gap-2 border-b border-slate-200 pb-3 sm:flex-row sm:items-end sm:justify-between sm:pb-5">
        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-emerald-700 sm:text-sm">Daily watch guide</p>
          <h1 class="mt-1 text-2xl font-semibold text-slate-950 sm:mt-2 sm:text-5xl">BetweenTheCups</h1>
          <p class="mt-1 max-w-2xl text-sm leading-5 text-slate-600 sm:mt-3 sm:text-base sm:leading-7">
            The best football to watch until the next World Cup.
          </p>
        </div>
        <div class="text-xs leading-5 text-slate-500 sm:text-sm sm:leading-6">
          Updated <span data-generated-at={data.generatedAt}>{generated}</span>
          <br />
          <span data-timezone-label>Times in your browser timezone</span>
        </div>
      </header>

      <section class="hidden grid-cols-3 gap-2 sm:grid sm:gap-3">
        <div class="rounded-lg border border-slate-200 bg-white p-2.5 shadow-sm sm:p-4">
          <div class="text-lg font-semibold text-slate-950 sm:text-2xl">{defaultSection.matches.length}</div>
          <div class="mt-1 text-xs text-slate-500 sm:text-sm">Today</div>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-2.5 shadow-sm sm:p-4">
          <div class="text-lg font-semibold text-slate-950 sm:text-2xl">
            {sections.find((section) => section.id === "week")?.matches.length ?? defaultSection.matches.length}
          </div>
          <div class="mt-1 text-xs text-slate-500 sm:text-sm">This week</div>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-2.5 shadow-sm sm:p-4">
          <div class="text-lg font-semibold text-slate-950 sm:text-2xl">
            {Math.max(...allSectionMatches.map((match) => match.excitement), 0)}
          </div>
          <div class="mt-1 text-xs text-slate-500 sm:text-sm">Top score</div>
        </div>
      </section>
      <div class="text-xs text-slate-500 sm:hidden">
        {defaultSection.matches.length} today · {sections.find((section) => section.id === "week")?.matches.length ?? defaultSection.matches.length} this week · top score {Math.max(...allSectionMatches.map((match) => match.excitement), 0)}
      </div>

      <nav class="grid grid-cols-4 border-b border-slate-200" aria-label="Match range">
        {
          sections.map((section, index) => (
            <button
              class:list={[
                "range-tab border-b-2 pb-2 text-center text-xs font-semibold sm:text-sm",
                index === 0
                  ? "border-emerald-700 text-emerald-800"
                  : "border-transparent text-slate-500 hover:text-emerald-800",
              ]}
              type="button"
              data-range-tab={section.id}
              aria-selected={index === 0 ? "true" : "false"}
            >
              {section.id === "horizon" ? "6 Months" : section.label}
            </button>
          ))
        }
      </nav>

      {
        sections.map((section, index) => (
          <section class:list={["range-panel flex flex-col gap-2", index !== 0 && "hidden"]} data-range-panel={section.id}>
            <div class="hidden sm:block">
              <h2 class="text-base font-semibold text-slate-950 sm:text-xl">{section.label}</h2>
              <p class="mt-1 text-sm text-slate-600">{section.description}</p>
            </div>
            {section.matches.length > 0 ? (
              <MatchTable matches={section.matches} tableId={`matches-${section.id}`} />
            ) : (
              <div class="rounded-lg border border-slate-200 bg-white px-4 py-8 text-sm text-slate-600 shadow-sm">
                No tracked matches found for this range.
              </div>
            )}
          </section>
        ))
      }

      <footer class="border-t border-slate-200 py-5 text-xs leading-5 text-slate-500 sm:text-sm sm:leading-6">
        Fixture and broadcast data come from public sources and may change. Check local listings before kickoff.
      </footer>
    </main>
    <script>
      const tabs = document.querySelectorAll("[data-range-tab]");
      const panels = document.querySelectorAll("[data-range-panel]");

      tabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          const active = tab.getAttribute("data-range-tab");
          tabs.forEach((candidate) => {
            const selected = candidate.getAttribute("data-range-tab") === active;
            candidate.setAttribute("aria-selected", String(selected));
            candidate.classList.toggle("border-emerald-700", selected);
            candidate.classList.toggle("text-emerald-800", selected);
            candidate.classList.toggle("border-transparent", !selected);
            candidate.classList.toggle("text-slate-500", !selected);
          });
          panels.forEach((panel) => {
            panel.classList.toggle("hidden", panel.getAttribute("data-range-panel") !== active);
          });
        });
      });

      const timeZone = Intl.DateTimeFormat().resolvedOptions().timeZone;
      const shortTimeZone =
        new Intl.DateTimeFormat("en-US", { timeZoneName: "short" })
          .formatToParts(new Date())
          .find((part) => part.type === "timeZoneName")?.value ?? timeZone;
      document.querySelectorAll("[data-timezone-label]").forEach((node) => {
        node.textContent = `Times shown in ${shortTimeZone}`;
      });

      const matchFormatter = new Intl.DateTimeFormat("en-US", {
        weekday: "short",
        month: "short",
        day: "numeric",
        hour: "numeric",
        minute: "2-digit",
        timeZoneName: "short",
      });

      document.querySelectorAll("[data-match-time]").forEach((node) => {
        const kickoff = node.getAttribute("data-match-time");
        if (kickoff) node.textContent = matchFormatter.format(new Date(kickoff));
      });

      const generatedFormatter = new Intl.DateTimeFormat("en-US", {
        month: "short",
        day: "numeric",
        year: "numeric",
        hour: "numeric",
        minute: "2-digit",
        timeZoneName: "short",
      });

      document.querySelectorAll("[data-generated-at]").forEach((node) => {
        const generatedAt = node.getAttribute("data-generated-at");
        if (generatedAt) node.textContent = generatedFormatter.format(new Date(generatedAt));
      });
    </script>
  </body>
</html>
